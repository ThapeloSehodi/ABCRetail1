@model ABCRetail.Models.OrderMessage

@{
    ViewData["Title"] = "Process Order";
}

<div class="container mt-4">

    <h1>Process Order</h1>

    <p class="text-muted">
        Create an order-processing message and send it
        to Azure Queue Storage.
    </p>

    <hr />

    <div class="row">

        <div class="col-md-6">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>

                <div class="mb-3">

                    <label asp-for="OrderId"
                           class="form-label">
                        Order ID
                    </label>

                    <input asp-for="OrderId"
                           class="form-control"
                           placeholder="ORD001" />

                    <span asp-validation-for="OrderId"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="CustomerId"
                           class="form-label">
                        Customer ID
                    </label>

                    <input asp-for="CustomerId"
                           class="form-control"
                           placeholder="C001" />

                </div>

                <div class="mb-3">

                    <label asp-for="ProductId"
                           class="form-label">
                        Product ID
                    </label>

                    <input asp-for="ProductId"
                           class="form-control"
                           placeholder="P001" />

                </div>

                <div class="mb-3">

                    <label asp-for="Quantity"
                           class="form-label">
                        Quantity
                    </label>

                    <input asp-for="Quantity"
                           type="number"
                           min="1"
                           class="form-control" />

                </div>

                <button type="submit"
                        class="btn btn-success">
                    Send Order for Processing
                </button>

                <a asp-action="Index"
                       class="btn btn-secondary">
                    Back
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}