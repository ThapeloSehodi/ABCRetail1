@model ABCRetail.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="container mt-4">

    <h1>Product Details</h1>

    <hr />

    <dl class="row">

        <dt class="col-sm-3">
            Product ID
        </dt>

        <dd class="col-sm-9">
            @Model.ProductId
        </dd>

        <dt class="col-sm-3">
            Product Name
        </dt>

        <dd class="col-sm-9">
            @Model.ProductName
        </dd>

        <dt class="col-sm-3">
            Description
        </dt>

        <dd class="col-sm-9">
            @Model.Description
        </dd>

        <dt class="col-sm-3">
            Price
        </dt>

        <dd class="col-sm-9">
            R @Model.Price.ToString("N2")
        </dd>

        <dt class="col-sm-3">
            Stock Quantity
        </dt>

        <dd class="col-sm-9">
            @Model.StockQuantity
        </dd>

        <dt class="col-sm-3">
            Image
        </dt>

        <dd class="col-sm-9">
            @Model.ImageName
        </dd>

    </dl>

    <a asp-action="Index"
           class="btn btn-secondary">
        Back to Products
    </a>

</div>
