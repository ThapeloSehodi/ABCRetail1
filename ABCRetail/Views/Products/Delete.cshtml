@model ABCRetail.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="container mt-4">

    <h1>Delete Product</h1>

    <div class="alert alert-warning">
        Are you sure you want to delete this product?
    </div>

    <dl class="row">

        <dt class="col-sm-3">
            Product ID
        </dt>

        <dd class="col-sm-9">
            @Model.ProductId
        </dd>

        <dt class="col-sm-3">
            Product Name
        </dt>

        <dd class="col-sm-9">
            @Model.ProductName
        </dd>

        <dt class="col-sm-3">
            Price
        </dt>

        <dd class="col-sm-9">
            R @Model.Price.ToString("N2")
        </dd>

        <dt class="col-sm-3">
            Stock
        </dt>

        <dd class="col-sm-9">
            @Model.StockQuantity
        </dd>

    </dl>

    <form asp-action="Delete"
          method="post">

        <input type="hidden"
               name="id"
               value="@Model.RowKey" />

        <button type="submit"
                class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index"
               class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>